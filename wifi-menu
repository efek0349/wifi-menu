#!/bin/sh

# Colors vars
RED="\033[0;031m"
BLU="\033[1;34m"
YLW="\033[1;33m"
RST="\033[1;0m"
GRN="\033[32m"
GRY="\033[37m"

INT=$1
WIFI_DIR="/etc/wifi_saved"

if [ "$(id -u)" != "0" ]; then
    echo -ne "[!] ${RED}This script needs to be run as root.\n${RST}"
    exit 1
fi

if [ -z "$INT" ]; then
    echo -ne "[!] ${RED} Usage: doas $0 ${YLW}[interface]${RST}\n"
    exit 1
fi

read_saved() {
    SAVED_LIST=$(cd "$WIFI_DIR" 2>/dev/null && echo *)

    if [ -z "$SAVED_LIST" ] || [ "$SAVED_LIST" = "*" ]; then
        echo -ne "[!] ${YLW}No previous WiFi connections found.\n${RST}"
        conf_create
        return
    fi

    i=1
    for j in $SAVED_LIST; do
        echo "$i) $j"
        eval "file_$i='$j'"
        i=$((i + 1))
    done

    echo
    echo -ne "[+] ${BLU}Select a previously saved WiFi connection or press ${YLW}\"Enter\" ${BLU}to skip: ${RST}"
    read v_CHOOSELIST

    eval "SELECTED=\${file_$v_CHOOSELIST}"

    if [ -z "$SELECTED" ]; then
        conf_create
        return
    fi

    echo -ne "[+] ${YLW}\"$SELECTED\" ${BLU}is selected\n${RST}"
    saved_connect "$SELECTED"
}

conf_create() {
    LIST=$(/sbin/ifconfig "$INT" scan 2>/dev/null |
        sed -ne 's/^.*nwid \(.*\) chan .*$/\1/p' | tr -d \" | sed '/^$/d' | sort | uniq)

    if [ -z "$LIST" ]; then
        echo -ne "[!] ${RED}No available wifi connection using $INT\n${RST}"
        exit 1
    fi

    i=1
    for j in $LIST; do
        echo "$i) $j"
        eval "list_$i='$j'"
        i=$((i + 1))
    done

    echo
    echo -ne "[+] ${BLU}Select a WiFi connection or press ${YLW}\"Enter\" ${BLU}to exit: ${RST}"
    read i_CHOOSELIST

    eval "ESSID=\${list_$i_CHOOSELIST}"

    if [ -z "$ESSID" ]; then
        echo -ne "[!] ${RED}Exiting\n${RST}"
        exit 1
    fi

    echo -ne "[+] ${BLU}Please enter the passphrase for ${YLW}\"$ESSID\"?\n${RST}"
    echo -ne "[+] Password: "
    stty -echo
    read PASSWORD
    stty echo
    echo

    if [ ${#PASSWORD} -lt 8 ]; then
        echo -ne "[!] ${RED}wpakey:${YLW} passphrase must be between 8 and 63 characters${RST}\n"
        exit 1
    fi

    CONF_FILE="$WIFI_DIR/$ESSID.$INT"

    echo "lladdr random join $ESSID wpakey $PASSWORD
inet autoconf
up" > "$CONF_FILE"

    chmod 600 "$CONF_FILE"

    echo -ne "[+] ${BLU}Creating new configuration for the ${YLW}\"$ESSID\"${RST}${BLU} wireless network.\n${RST}"
    connect "$ESSID"
}

saved_connect() {
    FILE_NAME="$1"
    CONF_FILE="$WIFI_DIR/$FILE_NAME"

    echo -ne "[+] ${BLU}Connecting using the ${YLW}\"$FILE_NAME\"${RST}${BLU} configuration file.${RST}\n"

    ESSID=$(grep join "$CONF_FILE" | head -1 | awk '{print $4}')
    WPAKEY=$(grep wpakey "$CONF_FILE" | head -1 | awk '{print $6}')

    /sbin/ifconfig "$INT" lladdr random up
    /sbin/ifconfig "$INT" nwid "$ESSID" wpakey "$WPAKEY"

    cp "$CONF_FILE" "/etc/hostname.$INT"
    chmod 600 "/etc/hostname.$INT"

    echo -ne "[+] ${BLU}Interface ${YLW}$INT${BLU} configured (ESSID: ${YLW}\"$FILE_NAME\"${RST})\n"
    echo -ne "[+] ${BLU}Running dhcpleasectl${RST}\n"

    /usr/sbin/dhcpleasectl "$INT"

    if rcctl ls all | grep -q dnscrypt_proxy; then
        rcctl restart dnscrypt_proxy unbound dhcpleased
    else
        rcctl restart unbound dhcpleased
    fi

    exit 0
}

connect() {
    ESSID="$1"
    CONF_FILE="$WIFI_DIR/$ESSID.$INT"

    echo -ne "[+] ${BLU}Connecting using file ${YLW}\"$ESSID\"${RST}\n"

    /sbin/ifconfig "$INT" lladdr random up
    /sbin/ifconfig "$INT" nwid "$ESSID" wpakey "$PASSWORD"

    cp "$CONF_FILE" "/etc/hostname.$INT"
    chmod 600 "/etc/hostname.$INT"

    echo -ne "[+] ${BLU}Interface ${YLW}$INT${BLU} configured (ESSID: ${YLW}\"$ESSID\"${RST})\n"
    echo -ne "[+] ${BLU}Running dhcpleasectl${RST}\n"

    /usr/sbin/dhcpleasectl "$INT"

    if rcctl ls all | grep -q dnscrypt_proxy; then
        rcctl restart dnscrypt_proxy unbound dhcpleased
    else
        rcctl restart unbound dhcpleased
    fi

    exit 0
}

### UI ###
clear
echo -ne "$GRN   .;'                     \`;,            \n"
echo -ne "$GRN  .;'  ,;'             \`;,  \`;,    OpenBSD Wireless Network Management Script\n"
echo -ne "$GRN .;'  ,;'  ,;'     \`;,  \`;,  \`;,   OS      :$RST`uname -srm`\n"
echo -ne "$GRN ::   ::   :   $GRY( ) $GRN  :   ::   ::   SHELL   :$RST${SHELL##*/}\n"
echo -ne "$GRN ':.  ':.  ':. $GRY/_\\ $GRN,:'  ,:'  ,:'   TERM    :$RST$TERM\n"
echo -ne "$GRN  ':.  ':.    $GRY/___\\ $GRN   ,:'  ,:'    PC      :$RST`sysctl -n hw.vendor` `sysctl -n hw.product`\n"
echo -ne "$GRN   ':.       $GRY/_____\\ $GRN     ,:'\n"
echo -ne "$GRN            $GRY/       \\ $GRN    ${RST}\n\n"

[ -d "$WIFI_DIR" ] || mkdir -p -m 700 "$WIFI_DIR"

read_saved
